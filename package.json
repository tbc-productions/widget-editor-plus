{
  "name": "widget-editor-plus",
  "version": "1.24.1",
  "description": "Enhanced Service Portal widget editor with Monaco-powered code editors, real-time user presence, per-field save, version history with diff comparison, and Angular template and provider management.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "imports": {
    "#now:*": "./@types/servicenow/fluent/*/index.js"
  },
  "scripts": {
    "build": "now-sdk build",
    "deploy": "now-sdk install",
    "pack": "now-sdk pack && node scripts/generate-update-set-xml.js",
    "transform": "now-sdk transform",
    "types": "now-sdk dependencies",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src scripts tests",
    "format": "prettier --write 'src/**/*.js' 'scripts/*.js' '*.cjs' '*.json' '.github/workflows/*.yaml'",
    "format:check": "prettier --check 'src/**/*.js' 'scripts/*.js' '*.cjs' '*.json' '.github/workflows/*.yaml'"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@servicenow/glide": "27.0.5",
    "@servicenow/sdk": "4.13.6",
    "angular": "1.5.11",
    "dotenv": "18.0.7",
    "eslint": "9.39.5",
    "prettier": "3.6.1",
    "typescript": "6.0.3"
  }
}
